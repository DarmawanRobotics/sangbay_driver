#!/usr/bin/env python3
"""ROS node for Sangbay gas sensors: any number of S-M4 / S-M4T / K-5S modules (Modbus,
several per RS485 bus), GT-TS01A and SLTD-CH4-100 laser methane sensors.

Per sensor <name>, in the node's namespace:
  <name>/concentration  std_msgs/Float32  in <name>/unit; not published while preheating
  <name>/unit           std_msgs/String   ppm, %LEL, %VOL, ppm*m, ... (latched)
  <name>/status         std_msgs/String   NORMAL, PREHEATING (12.3 s), HIGH, NO DATA: ... (latched)
  <name>/alarm          std_msgs/Bool     gas alarm (latched)
  <name>/fault          std_msgs/Bool     sensor fault or no data (latched)
  <name>/<extra>        std_msgs/Float32  GT-TS01A: temperature, pressure;
                                          SLTD-CH4-100: light_intensity, laser_temperature
  /diagnostics          diagnostic_msgs/DiagnosticArray, one status per sensor
"""

import threading

import rospy
from diagnostic_msgs.msg import DiagnosticArray, DiagnosticStatus, KeyValue
from std_msgs.msg import Bool, Float32, String

from sangbay_driver import config
from sangbay_driver.bus import Bus, Listener


class SensorTopics(object):
    def __init__(self, sensor):
        self.sensor = sensor
        n = sensor.name
        self.concentration = rospy.Publisher(n + '/concentration', Float32, queue_size=10)
        self.unit = rospy.Publisher(n + '/unit', String, queue_size=1, latch=True)
        self.status = rospy.Publisher(n + '/status', String, queue_size=10, latch=True)
        self.alarm = rospy.Publisher(n + '/alarm', Bool, queue_size=10, latch=True)
        self.fault = rospy.Publisher(n + '/fault', Bool, queue_size=10, latch=True)
        self.extra = {}
        self.last_unit = None
        self.last_status = None
        self.last_alarm = None
        self.last_fault = None
        self.last_error = None
        self.reading = None
        self.reading_time = None
        self.error = 'waiting for the first reading'
        self.info = {}

    def publish_state(self, status, alarm, fault):
        self.status.publish(String(status))
        if alarm != self.last_alarm or fault != self.last_fault or status != self.last_status:
            self.alarm.publish(Bool(alarm))
            self.fault.publish(Bool(fault))
        self.last_status, self.last_alarm, self.last_fault = status, alarm, fault


class SangbayNode(Listener):
    def __init__(self):
        default_port = rospy.get_param('~port', '')
        self.rate = float(rospy.get_param('~rate', 1.0))
        if self.rate <= 0:
            raise config.ConfigError('rate must be > 0')
        self.buses_config = config.parse(rospy.get_param('~sensors', []), default_port or None)
        self.lock = threading.Lock()
        self.topics = {}
        for b in self.buses_config:
            for s in b.sensors:
                self.topics[s.name] = SensorTopics(s)
        self.diag_pub = rospy.Publisher('/diagnostics', DiagnosticArray, queue_size=10)
        self.buses = [
            Bus(b, self, rate=self.rate,
                timeout=float(rospy.get_param('~timeout', 0.3)),
                retries=int(rospy.get_param('~retries', 2)),
                reconnect_sec=float(rospy.get_param('~reconnect_sec', 2.0)),
                max_failures=int(rospy.get_param('~max_failures', 3)))
            for b in self.buses_config]
        for b in self.buses_config:
            rospy.loginfo('%s (%d baud): %s', b.port, b.baud, ', '.join(
                '%s %s' % (s.name, ('#%d' % s.address) if s.type == 'module' else s.type)
                for s in b.sensors))

    # -- Listener (bus threads) ----------------------------------------------

    def on_log(self, error, text):
        (rospy.logwarn if error else rospy.loginfo)(text)

    def on_info(self, sensor, info):
        t = self.topics[sensor.name]
        t.info = info
        if sensor.type == 'module':
            rospy.loginfo('%s: %s (%s), %s, %s decimal places, address %d', sensor.name, info['gas'],
                          info['gas_description'], info['unit'], info['decimals'], sensor.address)

    def on_reading(self, sensor, r):
        t = self.topics[sensor.name]
        with self.lock:
            if t.last_error:
                rospy.loginfo('%s: readings back', sensor.name)
            t.reading, t.reading_time, t.error, t.last_error = r, rospy.Time.now(), None, None
        if r.unit != t.last_unit:
            t.unit.publish(String(r.unit))
            t.last_unit = r.unit
        if r.valid:
            t.concentration.publish(Float32(r.concentration))
            for key, value in r.extra.items():
                if key not in t.extra:
                    t.extra[key] = rospy.Publisher(sensor.name + '/' + key, Float32, queue_size=10)
                t.extra[key].publish(Float32(value))
        t.publish_state(r.status, r.alarm, r.fault)

    def on_error(self, sensor, message):
        t = self.topics[sensor.name]
        with self.lock:
            new = message != t.last_error
            t.error, t.last_error = message, message
        if new:
            rospy.logwarn('%s: %s', sensor.name, message)
        # Keep the last alarm state; a sensor that does not answer is a fault.
        t.publish_state('NO DATA: ' + message, bool(t.last_alarm), True)

    # -- diagnostics ---------------------------------------------------------

    def publish_diagnostics(self, _event=None):
        array = DiagnosticArray()
        array.header.stamp = rospy.Time.now()
        for name, t in self.topics.items():
            with self.lock:
                r, error = t.reading, t.error
            st = DiagnosticStatus(name='sangbay: %s' % name, hardware_id=t.sensor.hardware_id)
            st.values = [KeyValue('type', t.sensor.type), KeyValue('port', t.sensor.port)]
            if error or r is None:
                st.level = DiagnosticStatus.ERROR
                st.message = error or 'no reading'
            else:
                if r.fault:
                    st.level = DiagnosticStatus.ERROR
                elif r.alarm or not r.valid:
                    st.level = DiagnosticStatus.WARN
                else:
                    st.level = DiagnosticStatus.OK
                st.message = '%s %g %s, %s' % (r.gas, r.concentration, r.unit, r.status)
                st.values += [KeyValue(k, v) for k, v in r.values]
                st.values.append(KeyValue('age', '%.1f s' % (rospy.Time.now() - t.reading_time).to_sec()))
            array.status.append(st)
        self.diag_pub.publish(array)

    # -- run -----------------------------------------------------------------

    def run(self):
        for b in self.buses:
            b.start()
        timer = rospy.Timer(rospy.Duration(1.0), self.publish_diagnostics)
        rospy.spin()
        timer.shutdown()
        for b in self.buses:
            b.stop()


def main():
    rospy.init_node('sangbay_driver')
    try:
        node = SangbayNode()
    except config.ConfigError as e:
        rospy.logfatal('configuration: %s', e)
        return
    node.run()


if __name__ == '__main__':
    main()
