#!/usr/bin/env python3
"""Read the sensor without ROS: sangbay_read [--port /dev/ttyUSB0] [--address 255] [--verbose]"""

import argparse
import time

from sangbay_driver.modbus import ModbusError, hexdump
from sangbay_driver.sensor import Sensor, gas_name, open_serial


class Logged(object):
    """Prints every frame."""

    def __init__(self, port):
        self.port = port

    def reset_input_buffer(self):
        self.port.reset_input_buffer()

    def write(self, data):
        print('[TX] %s' % hexdump(data))
        return self.port.write(data)

    def read(self, n):
        data = self.port.read(n)
        print('[RX] %s' % (hexdump(data) or '<no answer>'))
        return data


def main():
    p = argparse.ArgumentParser(description='Sangbay S-M4T reader')
    p.add_argument('--port', default='/dev/ttyUSB0')
    p.add_argument('--baud', type=int, default=9600)
    p.add_argument('--address', type=lambda s: int(s, 0), default=0xFF)
    p.add_argument('--interval', type=float, default=2.0)
    p.add_argument('--verbose', '-v', action='store_true', help='print the Modbus frames')
    args = p.parse_args()

    with open_serial(args.port, args.baud) as port:
        sensor = Sensor(Logged(port) if args.verbose else port, args.address)
        code, decimals = sensor.read_info()
        print('%s on %s, %d decimal places' % (gas_name(code), args.port, decimals))
        print('time      ppm        status')
        try:
            while True:
                stamp = time.strftime('%H:%M:%S')
                try:
                    r = sensor.read()
                    print('%s  %8.2f   %s' % (stamp, r.concentration, r.status.text))
                except ModbusError as e:
                    print('%s  --         %s' % (stamp, e))
                time.sleep(args.interval)
        except KeyboardInterrupt:
            pass


if __name__ == '__main__':
    main()
